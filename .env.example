# The server is intentionally loopback-only and refuses non-local binds.
HOST=127.0.0.1
PORT=3210

# Optional. Use an installed Brave executable instead of Playwright Chromium.
# Windows example:
# BRAVE_EXECUTABLE_PATH=C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe
BRAVE_EXECUTABLE_PATH=

# Time between submissions. Brave may rate-limit rapid repeats.
SUBMISSION_DELAY_MS=1500
VERIFICATION_TIMEOUT_MS=30000
